# Copy this file to .env.local and fill in what you need:
#   cp .env.example .env.local
# Nothing here is required to start `npm run dev`. NEXT_PUBLIC_ variables are
# baked into the browser bundle at build time, so restart the dev server (or
# rebuild) after changing them, and never put secrets in a NEXT_PUBLIC_ var.

# Backend API origin. Defaults to http://localhost:4000 when unset.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Soroban contracts (Stellar testnet). Donations and subscriptions need the
# donation contract ID. These are the v2 contracts from the README's contract
# table. Update them after a testnet reset or a redeploy (see
# docs/testnet-troubleshooting.md).
NEXT_PUBLIC_DONATION_CONTRACT_ID=CAO2UABEB4A3EYFTWCMOSTFAUZ5FBSFRESQGWQHOLASZ3RHDCQHQG2LP
# Registry ID for reference; the frontend does not read it today.
NEXT_PUBLIC_CREATOR_REGISTRY_CONTRACT_ID=CB6PH7KYI3UHAUNYIJVCV7CT6BOBROLSR4LSZB3WSGFOYOW6JFAF5NDU
# Defaults to https://soroban-testnet.stellar.org when unset.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Network segment used in stellar.expert links on the dashboard (default: testnet).
# NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Stablecoin issuers. USDC/USDT only appear in the donation UI when their issuer
# is set. On testnet, the SDF test USDC issuer is:
# NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA
# NEXT_PUBLIC_USDT_ISSUER=G...

# Client-side UX gate for /admin; backend ADMIN_WALLETS remains authoritative.
# NEXT_PUBLIC_ADMIN_WALLETS=GADMIN...

# SEP-24 cash-out anchor. If unset, lib/anchor.js uses the SDF reference anchor
# (testanchor.stellar.org / SRT). For the self-hosted anchor in anchor/, run
# `cd anchor && ./setup.sh` and use:
# NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=localhost:8080
# NEXT_PUBLIC_ANCHOR_ASSET_CODE=USDC

# Public origin used for absolute og:image / twitter:image URLs. Optional on
# Vercel (falls back to the production domain).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Error reporting (optional).
# NEXT_PUBLIC_SENTRY_DSN=

# Server-only secrets for Next.js API routes (never exposed to the browser).
# /api/prices: CoinGecko demo key; works without one at a lower rate limit.
# COINGECKO_API_KEY=
# /api/cloudinary-sign: signed avatar/banner uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
