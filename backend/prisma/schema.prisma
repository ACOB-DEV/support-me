generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  // Nullable: a magic-link (#15) or OAuth (#14) account has no wallet
  // until the user connects one. Still unique when set, so a wallet can
  // never be claimed by more than one account.
  walletAddress  String?         @unique
  // Contact/sign-in address. Required for a magic-link account (that's
  // the whole identity); optional otherwise, where it's only used for
  // transactional email (recurring-donation renewal/failure, donation
  // -received notices).
  email          String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  // Set by POST /api/account/delete when the holder anonymizes their data;
  // kept as an audit marker (cleared fields are the actual erasure).
  deletedAt      DateTime?
  creator        Creator?
  adminAuditLogs AdminAuditLog[]
  magicLinks     MagicLinkToken[]
  oauthIdentities OAuthIdentity[]
}

// Links a third-party OAuth identity (Twitter/X, and any future provider)
// to a User (#14). provider+providerAccountId is what create-or-attach
// keys off: a returning user is matched by this pair, not by email.
model OAuthIdentity {
  id                Int      @id @default(autoincrement())
  provider          String
  providerAccountId String
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A single-use, short-lived sign-in token emailed to a user for magic-link
// authentication (#15). Only the SHA-256 hash of the token is stored.
model MagicLinkToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  email     String
  userId    Int?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([userId])
}

model AdminAuditLog {
  id                 Int      @id @default(autoincrement())
  adminId            Int?
  admin              User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminWalletAddress String
  action             String
  targetType         String
  targetId           String
  before             Json?
  after              Json?
  requestId          String?
  createdAt          DateTime @default(now())

  @@index([createdAt, id])
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

model Creator {
  id            Int            @id @default(autoincrement())
  userId        Int            @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  username      String         @unique
  walletAddress String
  displayName   String?
  bio           String?
  avatarUrl     String?
  socialLinks   Json?
  acceptsXlm    Boolean        @default(true)
  acceptsUsdc   Boolean        @default(true)
  // Mirrors acceptsUsdc: defaults false (unlike XLM/USDC) since USDT support
  // is new — an existing creator shouldn't start accepting an asset they
  // never opted into just because this column appeared. See migration
  // 20260924030100_add_creator_accepts_usdt.
  acceptsUsdt   Boolean        @default(false)
  // Deprecated: superseded by the Goal model below, which supports multiple
  // and/or recurring goals (see migration
  // 20260924030000_add_goals_and_migrate_donation_goal). Kept nullable
  // rather than dropped so existing rows aren't destroyed by the schema
  // change alone — the migration copies each non-null value into a new Goal
  // row before the column stops being read by the API.
  donationGoal  Int?
  // Optional quick-select amounts a creator can configure for the donate
  // page's preset buttons (#120), e.g. [1, 5, 10, 25]. Nullable/empty means
  // the creator hasn't customized these — the frontend falls back to
  // hardcoded defaults rather than the API making up a default list, so an
  // empty array and "never configured" stay distinguishable if that
  // matters later. Denominated in whatever asset the supporter picks on
  // the donate page, same as Goal.currency — not tied to a single currency.
  presetAmounts Float[]        @default([])
  // Custom public-profile theme (#227): { backgroundColor, accentColor,
  // font, layout }, validated by schemas/creators.ts's themeSchema. Null
  // means the default design, so existing creators are unaffected.
  theme         Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  donations     Donation[]
  withdrawals   Withdrawal[]
  subscriptions Subscription[]
  goals         Goal[]

  @@index([walletAddress])
  // A non-empty walletAddress is unique across creators (#276). That is a
  // partial unique index ("walletAddress" <> '') created in migration
  // 20261018000000_creator_wallet_unique, which Prisma's schema language
  // cannot express, so it is not declared here.
}

model Donation {
  id              Int                     @id @default(autoincrement())
  creator         Creator                 @relation(fields: [creatorId], references: [id])
  creatorId       Int
  senderAddress   String
  amount          Decimal                 @db.Decimal(20, 7)
  currency        String                  @default("XLM")
  message         String?
  transactionHash String?
  // Stable identity for donations discovered from Soroban events. Replaying a
  // ledger lookback after a restart must not create another row.
  onChainEventId  String?                 @unique
  rpcEventId      String?                 @unique
  operationIndex  Int                     @default(0)
  eventIndex      Int                     @default(0)
  // Client-reported rows are provisional until the Soroban listener verifies
  // the corresponding event; legacy rows remain visible by default.
  verified        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  idempotencyKey  DonationIdempotencyKey?

  // Hot-path indexes (#264). The feed filters by creator and `verified` and
  // orders by `createdAt`; the leaderboard groups by `currency`; account
  // export and confirmation emails look donations up by sender.
  @@index([creatorId, verified, createdAt])
  @@index([senderAddress])
  @@index([currency, verified])
  @@unique([transactionHash, operationIndex, eventIndex])
}

model DonationIdempotencyKey {
  key        String   @id
  donationId Int      @unique
  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Withdrawal {
  id          Int      @id @default(autoincrement())
  creator     Creator  @relation(fields: [creatorId], references: [id])
  creatorId   Int
  amountIn    Decimal  @db.Decimal(20, 7) // crypto withdrawn (SEP-24 amount_in)
  amountOut   Decimal? @db.Decimal(20, 7) // fiat received (amount_out), when the anchor reports it
  fee         Decimal? @db.Decimal(20, 7) // amount_fee
  currency    String   @default("USDC") // asset withdrawn
  anchorTxId  String // SEP-24 transaction id
  stellarTxId String? // on-chain payment to the anchor (stellar_transaction_id)
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  // A given anchor transaction maps to exactly one withdrawal record. Lets the
  // POST handler be idempotent when the completion path fires more than once.
  @@unique([creatorId, anchorTxId])
  // Withdrawal history filters by creator and orders by `createdAt` (#264).
  @@index([creatorId, createdAt])
}

// A creator can track more than one goal at once (e.g. a one-off "New mic"
// target alongside a recurring "Monthly support" target). Each goal is
// denominated in a single asset (`currency`) and tracks its own progress
// server-side in `currentAmount` — donations increment it directly (see
// services/goalService.ts) rather than the frontend deriving progress by
// summing donations on every page load, which stopped being workable once a
// single donation can count toward several simultaneously-active goals.
model Goal {
  id            Int                 @id @default(autoincrement())
  creator       Creator             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId     Int
  // Short label so a creator with multiple goals can tell them apart in the
  // UI (e.g. "New microphone", "Monthly support"). Optional: a goal migrated
  // from the old single `donationGoal` field has none.
  title         String?
  // Optional longer blurb shown under the title on the public profile
  // (e.g. what the funds are for).
  description   String?
  targetAmount  Float
  currentAmount Float               @default(0)
  // Asset this goal is denominated in ("XLM", "USDC", "USDT", ...). Amounts
  // are tracked per-asset, never normalized to USD — see the reasoning in
  // services/goalService.ts.
  currency      String              @default("XLM")
  status        GoalStatus          @default(ACTIVE)
  recurring     Boolean             @default(false)
  // Only meaningful when `recurring` is true. Limited to the two intervals
  // the issue actually asks for ("e.g. monthly") rather than a general cron
  // expression, which nothing here needs yet.
  recurrenceInterval RecurrenceInterval?
  // Only meaningful when `recurring` is true: the instant the current
  // progress period ends and `currentAmount` resets to 0. Set to
  // `now() + interval` whenever a recurring goal is created or reset.
  currentPeriodEnd   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([creatorId])
  @@index([recurring, currentPeriodEnd])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
}

model Subscription {
  id                Int       @id @default(autoincrement())
  creator           Creator   @relation(fields: [creatorId], references: [id])
  creatorId         Int
  supporterAddress  String
  token             String // asset code, e.g. "XLM" or "USDC"
  amount            Decimal @db.Decimal(20, 7) // amount charged per interval
  intervalSecs      Int
  onChainId         Int       @unique // subscription_id returned by the donation contract's subscribe()
  subscribeTxHash   String?
  nextChargeAt      DateTime
  active            Boolean   @default(true)
  lastChargeTxHash  String?
  lastChargedAt     DateTime?
  // Set by the executor when a charge attempt fails (e.g. revoked allowance)
  // and cleared on the next successful charge, so failures are visible
  // without the executor retrying forever on its own.
  lastError         String?
  failureCount      Int       @default(0)
  // When the supporter was last emailed about a failing charge, so the
  // executor (which retries every tick) sends one notice per failure streak
  // instead of one per retry. Cleared on the next successful charge.
  failureNotifiedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Hot-path indexes (#264). The executor polls due rows every tick
  // (`active` + `nextChargeAt`); account export and deletion filter by
  // supporter; creator-facing lists filter by creator.
  @@index([active, nextChargeAt])
  @@index([supporterAddress])
  @@index([creatorId])
}

enum EmailEventType {
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

// One row per email send attempt, plus one row per delivery-status webhook
// (delivered/bounced/complained) Resend sends back for it. Keyed by
// recipient address rather than a User relation: webhook payloads only ever
// give us the address, and a bounce needs to be actionable even if the
// sending code path didn't have a User row on hand.
model EmailEvent {
  id                Int            @id @default(autoincrement())
  recipient         String
  subject           String
  type              EmailEventType
  // Resend's message id, so a later webhook (delivered/bounced/complained)
  // can be linked back to the SENT row for the same recipient. Null for
  // send attempts that failed before Resend returned an id.
  providerMessageId String?
  // Populated on FAILED/BOUNCED rows so the failure is diagnosable from the
  // row alone, without cross-referencing stdout logs.
  errorDetail       String?
  createdAt         DateTime       @default(now())

  @@index([recipient, createdAt])
  @@index([providerMessageId])
}

// Small key/value store for operational state that must survive restarts.
// Currently holds the last Soroban ledger sequence the backend observed
// (`soroban:lastSeenLedger`), which testnet-reset detection (#278) compares
// against the chain's latest sequence — a jump backwards means the network
// was wiped and every on-chain ID the backend cached is invalid.
model NetworkCheckpoint {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
